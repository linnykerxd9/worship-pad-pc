<Window x:Class="WorshipPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OpenWorshipPad"
        Width="900"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <Window.Resources>

        <!-- Botão dos pads -->
        <Style x:Key="PadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="15">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- Cabeçalho -->

        <DockPanel Grid.Row="0">

            <TextBlock
                Text="OpenWorshipPad"
                Foreground="White"
                FontSize="32"
                FontWeight="Bold"
                DockPanel.Dock="Left"/>


            <Button
                Content="⚙"
                Width="45"
                Height="45"
                FontSize="22"
                DockPanel.Dock="Right"/>

        </DockPanel>



        <!-- Banco -->

        <TextBlock
            Grid.Row="1"
            Text="Signature"
            Foreground="#AAAAAA"
            FontSize="22"
            Margin="0,30,0,20"
            HorizontalAlignment="Center"/>



        <!-- Pads -->

        <UniformGrid
            Grid.Row="2"
            Columns="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">


            <Button Content="C"
                    Style="{StaticResource PadButtonStyle}"/>

            <Button Content="C#"
                    Style="{StaticResource PadButtonStyle}"/>

            <Button Content="D"
                    Style="{StaticResource PadButtonStyle}"/>

            <Button Content="D#"
                    Style="{StaticResource PadButtonStyle}"/>


            <Button Content="E"
                    Style="{StaticResource PadButtonStyle}"/>

            <Button Content="F"
                    Style="{StaticResource PadButtonStyle}"/>

            <Button Content="F#"
                    Style="{StaticResource PadButtonStyle}"/>

            <Button Content="G"
                    Style="{StaticResource PadButtonStyle}"/>


            <Button Content="G#"
                    Style="{StaticResource PadButtonStyle}"/>

            <Button Content="A"
                    Style="{StaticResource PadButtonStyle}"/>

            <Button Content="A#"
                    Style="{StaticResource PadButtonStyle}"/>

            <Button Content="B"
                    Style="{StaticResource PadButtonStyle}"/>


        </UniformGrid>



        <!-- Volume -->

        <StackPanel
            Grid.Row="3"
            Margin="0,30">

            <TextBlock
                Text="Volume"
                Foreground="White"
                FontSize="18"/>


            <Slider
                Minimum="0"
                Maximum="100"
                Value="80"
                Height="35"/>


            <TextBlock
                Text="80%"
                Foreground="#AAAAAA"
                HorizontalAlignment="Center"/>

        </StackPanel>



        <!-- Status -->

        <Border
            Grid.Row="4"
            Background="#1E1E1E"
            CornerRadius="10"
            Padding="15">


            <StackPanel>

                <TextBlock
                    Text="XR18 USB ASIO"
                    Foreground="White"
                    FontSize="16"/>


                <TextBlock
                    Text="● Desconectado"
                    Foreground="#FF5555"
                    Margin="0,5,0,0"/>


            </StackPanel>


        </Border>


    </Grid>

</Window>