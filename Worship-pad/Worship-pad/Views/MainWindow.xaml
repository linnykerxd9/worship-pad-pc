<Window
    x:Class="WorshipPad.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Icon="../Assets/worshippad.ico"
    Title="WorshipPad"
    WindowState="Maximized"
    MinWidth="800"
    MinHeight="500"
    Background="#20242B">

    <Window.Resources>

        <!-- ================================================= -->
        <!-- CORES / GRADIENTES -->
        <!-- ================================================= -->

        <!-- PAD NORMAL -->

        <LinearGradientBrush
            x:Key="PadNormalBackground"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#414751"
                Offset="0"/>

            <GradientStop
                Color="#343A44"
                Offset="0.5"/>

            <GradientStop
                Color="#292E37"
                Offset="1"/>

        </LinearGradientBrush>


        <!-- PAD HOVER -->

        <LinearGradientBrush
            x:Key="PadHoverBackground"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#626A77"
                Offset="0"/>

            <GradientStop
                Color="#505864"
                Offset="0.5"/>

            <GradientStop
                Color="#414853"
                Offset="1"/>

        </LinearGradientBrush>


        <!-- PAD TOCANDO -->

        <LinearGradientBrush
            x:Key="PadPlayingBackground"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#00FFD0"
                Offset="0"/>

            <GradientStop
                Color="#00FFC0"
                Offset="0.35"/>

            <GradientStop
                Color="#00E9B0"
                Offset="0.7"/>

            <GradientStop
                Color="#00C89F"
                Offset="1"/>

        </LinearGradientBrush>


        <!-- BANCO -->

        <LinearGradientBrush
            x:Key="BankNormalBackground"
            StartPoint="0,0"
            EndPoint="1,0">

            <GradientStop
                Color="#414751"
                Offset="0"/>

            <GradientStop
                Color="#2E333C"
                Offset="1"/>

        </LinearGradientBrush>


        <!-- BANCO HOVER -->

        <LinearGradientBrush
            x:Key="BankHoverBackground"
            StartPoint="0,0"
            EndPoint="1,0">

            <GradientStop
                Color="#606875"
                Offset="0"/>

            <GradientStop
                Color="#454C58"
                Offset="1"/>

        </LinearGradientBrush>


        <!-- BANCO SELECIONADO -->

        <LinearGradientBrush
            x:Key="BankSelectedBackground"
            StartPoint="0,0"
            EndPoint="1,0">

            <GradientStop
                Color="#00FFD0"
                Offset="0"/>

            <GradientStop
                Color="#00F5BE"
                Offset="0.4"/>

            <GradientStop
                Color="#00DFAE"
                Offset="0.7"/>

            <GradientStop
                Color="#00B998"
                Offset="1"/>

        </LinearGradientBrush>


        <!-- BOTÕES DO SISTEMA -->

        <LinearGradientBrush
            x:Key="SystemButtonBackground"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#414751"
                Offset="0"/>

            <GradientStop
                Color="#2D323B"
                Offset="1"/>

        </LinearGradientBrush>


        <!-- STOP NORMAL -->

        <LinearGradientBrush
            x:Key="StopNormalBackground"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#414751"
                Offset="0"/>

            <GradientStop
                Color="#2D323B"
                Offset="1"/>

        </LinearGradientBrush>


        <!-- STOP HOVER -->

        <LinearGradientBrush
            x:Key="StopHoverBackground"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#FF5268"
                Offset="0"/>

            <GradientStop
                Color="#E7354D"
                Offset="0.5"/>

            <GradientStop
                Color="#B91F37"
                Offset="1"/>

        </LinearGradientBrush>


        <!-- ================================================= -->
        <!-- TEMPLATE BASE ARREDONDADO -->
        <!-- ================================================= -->

        <ControlTemplate
            x:Key="RoundedButtonTemplate"
            TargetType="Button">

            <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="10"
                Padding="{TemplateBinding Padding}">

                <ContentPresenter
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentStringFormat="{TemplateBinding ContentStringFormat}"/>

            </Border>

        </ControlTemplate>


        <!-- ================================================= -->
        <!-- PAD DE NOTA -->
        <!-- ================================================= -->

        <Style
            x:Key="PadButtonStyle"
            TargetType="Button">

            <Setter
                Property="Template"
                Value="{StaticResource RoundedButtonTemplate}"/>

            <Setter
                Property="Background"
                Value="{StaticResource PadNormalBackground}"/>

            <Setter
                Property="Foreground"
                Value="#F5F7FA"/>

            <Setter
                Property="FontSize"
                Value="28"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

            <Setter
                Property="Margin"
                Value="8"/>

            <Setter
                Property="Padding"
                Value="5"/>

            <Setter
                Property="MinWidth"
                Value="80"/>

            <Setter
                Property="MinHeight"
                Value="60"/>

            <Setter
                Property="HorizontalAlignment"
                Value="Stretch"/>

            <Setter
                Property="VerticalAlignment"
                Value="Stretch"/>

            <Setter
                Property="HorizontalContentAlignment"
                Value="Center"/>

            <Setter
                Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="BorderBrush"
                Value="#505763"/>


            <Style.Triggers>

                <!-- TOCANDO -->

                <DataTrigger
                    Binding="{Binding IsPlaying}"
                    Value="True">

                    <Setter
                        Property="Background"
                        Value="{StaticResource PadPlayingBackground}"/>

                    <Setter
                        Property="BorderBrush"
                        Value="#00FFD0"/>

                    <Setter
                        Property="Foreground"
                        Value="White"/>

                </DataTrigger>


                <!-- HOVER -->

                <Trigger
                    Property="IsMouseOver"
                    Value="True">

                    <Setter
                        Property="Background"
                        Value="{StaticResource PadHoverBackground}"/>

                    <Setter
                        Property="BorderBrush"
                        Value="#737C8B"/>

                    <Setter
                        Property="Foreground"
                        Value="White"/>

                </Trigger>


                <!-- PRESSIONADO -->

                <Trigger
                    Property="IsPressed"
                    Value="True">

                    <Setter
                        Property="Opacity"
                        Value="0.7"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ================================================= -->
        <!-- ÁUDIO / MÚSICA -->
        <!-- ================================================= -->

        <Style
            x:Key="AudioButtonStyle"
            TargetType="Button">

            <Setter
                Property="Template"
                Value="{StaticResource RoundedButtonTemplate}"/>

            <Setter
                Property="Background"
                Value="{StaticResource PadNormalBackground}"/>

            <Setter
                Property="Foreground"
                Value="#F5F7FA"/>

            <Setter
                Property="FontSize"
                Value="16"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

            <Setter
                Property="Margin"
                Value="6"/>

            <Setter
                Property="Padding"
                Value="12,10"/>

            <Setter
                Property="MinHeight"
                Value="50"/>

            <Setter
                Property="HorizontalAlignment"
                Value="Stretch"/>

            <Setter
                Property="HorizontalContentAlignment"
                Value="Left"/>

            <Setter
                Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="BorderBrush"
                Value="#505763"/>


            <Style.Triggers>

                <!-- TOCANDO -->

                <DataTrigger
                    Binding="{Binding IsPlaying}"
                    Value="True">

                    <Setter
                        Property="Background"
                        Value="{StaticResource PadPlayingBackground}"/>

                    <Setter
                        Property="BorderBrush"
                        Value="#00FFD0"/>

                    <Setter
                        Property="Foreground"
                        Value="White"/>

                </DataTrigger>


                <!-- HOVER -->

                <Trigger
                    Property="IsMouseOver"
                    Value="True">

                    <Setter
                        Property="Background"
                        Value="{StaticResource PadHoverBackground}"/>

                    <Setter
                        Property="BorderBrush"
                        Value="#737C8B"/>

                </Trigger>


                <!-- PRESSIONADO -->

                <Trigger
                    Property="IsPressed"
                    Value="True">

                    <Setter
                        Property="Opacity"
                        Value="0.7"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ================================================= -->
        <!-- BANCO -->
        <!-- ================================================= -->

        <Style
            x:Key="BankButtonStyle"
            TargetType="Button">

            <Setter
                Property="Template"
                Value="{StaticResource RoundedButtonTemplate}"/>

            <Setter
                Property="Background"
                Value="{StaticResource BankNormalBackground}"/>

            <Setter
                Property="Foreground"
                Value="#E8ECF1"/>

            <Setter
                Property="FontSize"
                Value="14"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

            <Setter
                Property="Padding"
                Value="16,8"/>

            <Setter
                Property="Margin"
                Value="4"/>

            <Setter
                Property="MinWidth"
                Value="80"/>

            <Setter
                Property="Height"
                Value="38"/>

            <Setter
                Property="HorizontalContentAlignment"
                Value="Center"/>

            <Setter
                Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="BorderBrush"
                Value="#505763"/>


            <Style.Triggers>

                <!-- BANCO SELECIONADO -->

                <DataTrigger
                    Binding="{Binding IsSelected}"
                    Value="True">

                    <Setter
                        Property="Background"
                        Value="{StaticResource BankSelectedBackground}"/>

                    <Setter
                        Property="BorderBrush"
                        Value="#00FFD0"/>

                    <Setter
                        Property="Foreground"
                        Value="White"/>

                    <Setter
                        Property="FontWeight"
                        Value="Bold"/>

                </DataTrigger>


                <!-- HOVER -->

                <Trigger
                    Property="IsMouseOver"
                    Value="True">

                    <Setter
                        Property="Background"
                        Value="{StaticResource BankHoverBackground}"/>

                    <Setter
                        Property="BorderBrush"
                        Value="#737C8B"/>

                </Trigger>


                <!-- PRESSIONADO -->

                <Trigger
                    Property="IsPressed"
                    Value="True">

                    <Setter
                        Property="Opacity"
                        Value="0.7"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ================================================= -->
        <!-- BOTÕES DO SISTEMA -->
        <!-- ================================================= -->

        <Style
            x:Key="SystemButtonStyle"
            TargetType="Button">

            <Setter
                Property="Template"
                Value="{StaticResource RoundedButtonTemplate}"/>

            <Setter
                Property="Background"
                Value="{StaticResource SystemButtonBackground}"/>

            <Setter
                Property="Foreground"
                Value="#E9EDF2"/>

            <Setter
                Property="FontSize"
                Value="13"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

            <Setter
                Property="Padding"
                Value="5"/>

            <Setter
                Property="HorizontalContentAlignment"
                Value="Center"/>

            <Setter
                Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="BorderBrush"
                Value="#505763"/>


            <Style.Triggers>

                <!-- HOVER -->

                <Trigger
                    Property="IsMouseOver"
                    Value="True">

                    <Setter
                        Property="Background"
                        Value="#5A626F"/>

                    <Setter
                        Property="BorderBrush"
                        Value="#7B8595"/>

                    <Setter
                        Property="Foreground"
                        Value="White"/>

                </Trigger>


                <!-- PRESSIONADO -->

                <Trigger
                    Property="IsPressed"
                    Value="True">

                    <Setter
                        Property="Opacity"
                        Value="0.65"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ================================================= -->
        <!-- STOP -->
        <!-- ================================================= -->

        <Style
            x:Key="StopButtonStyle"
            TargetType="Button">

            <Setter
                Property="Template"
                Value="{StaticResource RoundedButtonTemplate}"/>

            <Setter
                Property="Background"
                Value="{StaticResource StopNormalBackground}"/>

            <Setter
                Property="Foreground"
                Value="#F1F3F5"/>

            <Setter
                Property="FontSize"
                Value="13"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

            <Setter
                Property="Padding"
                Value="5"/>

            <Setter
                Property="HorizontalContentAlignment"
                Value="Center"/>

            <Setter
                Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="BorderBrush"
                Value="#505763"/>


            <Style.Triggers>

                <!-- HOVER -->

                <Trigger
                    Property="IsMouseOver"
                    Value="True">

                    <Setter
                        Property="Background"
                        Value="{StaticResource StopHoverBackground}"/>

                    <Setter
                        Property="BorderBrush"
                        Value="#FF7182"/>

                    <Setter
                        Property="Foreground"
                        Value="White"/>

                </Trigger>


                <!-- PRESSIONADO -->

                <Trigger
                    Property="IsPressed"
                    Value="True">

                    <Setter
                        Property="Opacity"
                        Value="0.65"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>


    <!-- ================================================= -->
    <!-- LAYOUT PRINCIPAL -->
    <!-- ================================================= -->

    <Grid
        Margin="20">

        <Grid.RowDefinitions>

            <!-- Bancos + botões -->

            <RowDefinition
                Height="Auto"/>

            <!-- Banco atual -->

            <RowDefinition
                Height="Auto"/>

            <!-- Pesquisa -->

            <RowDefinition
                Height="Auto"/>

            <!-- Áudios -->

            <RowDefinition
                Height="*"/>

            <!-- Stop -->

            <RowDefinition
                Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- ÁREA SUPERIOR -->
        <!-- ================================================= -->

        <Grid
            Grid.Row="0">

            <Grid.ColumnDefinitions>

                <!-- Bancos -->

                <ColumnDefinition
                    Width="*"/>

                <!-- Botões -->

                <ColumnDefinition
                    Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- BANCOS -->
            <!-- ================================================= -->

            <ScrollViewer
                Grid.Column="0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                MaxHeight="100">

                <ItemsControl
                    ItemsSource="{Binding Banks}">

                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>

                            <WrapPanel
                                Orientation="Horizontal"/>

                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>


                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button
                                Content="{Binding DisplayName}"
                                Style="{StaticResource BankButtonStyle}"
                                Command="{Binding DataContext.SelectBankCommand,
                                    RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding}"/>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>


            <!-- ================================================= -->
            <!-- BOTÕES DO SISTEMA -->
            <!-- ================================================= -->

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">

                <Button
                    Content="⚙ Configurações"
                    Width="150"
                    Height="40"
                    Margin="10,0,0,5"
                    Style="{StaticResource SystemButtonStyle}"
                    Click="OpenSettings_Click"/>


                <Button
                    Content="📋 Logs do sistema"
                    Width="150"
                    Height="40"
                    Margin="10,5,0,5"
                    Style="{StaticResource SystemButtonStyle}"
                    Click="OpenLogs_Click"/>


                <Button
                    Content="🔄 Atualizar"
                    Width="150"
                    Height="40"
                    Margin="10,5,0,0"
                    Style="{StaticResource SystemButtonStyle}"
                    Command="{Binding RefreshBanksCommand}"/>

            </StackPanel>

        </Grid>


        <!-- ================================================= -->
        <!-- BANCO ATUAL -->
        <!-- ================================================= -->

        <TextBlock
            Grid.Row="1"
            Text="{Binding CurrentBank}"
            Foreground="#F1F3F5"
            FontSize="23"
            FontWeight="SemiBold"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Margin="10,15,10,10"/>


        <!-- ================================================= -->
        <!-- PESQUISA -->
        <!-- ================================================= -->

        <Grid
            Grid.Row="2"
            Margin="0,0,0,15">

            <TextBox
                Width="350"
                Height="40"
                HorizontalAlignment="Left"
                FontSize="15"
                Padding="12,5"
                Foreground="#F1F3F5"
                Background="#2D323B"
                BorderBrush="#505763"
                BorderThickness="1"
                VerticalContentAlignment="Center"
                Text="{Binding SearchText,
                    UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Pesquisar áudio..."/>

            <TextBlock
                Text="🔎"
                FontSize="19"
                Foreground="#AEB5C0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="320,0,0,0"
                IsHitTestVisible="False"/>

        </Grid>


        <!-- ================================================= -->
        <!-- ÁREA DOS ÁUDIOS -->
        <!-- ================================================= -->

        <ScrollViewer
            Grid.Row="3"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <Grid>

                <!-- ================================================= -->
                <!-- BANCO DE NOTAS -->
                <!-- ================================================= -->

                <ItemsControl
                    ItemsSource="{Binding FilteredPads}">

                    <ItemsControl.Style>

                        <Style
                            TargetType="ItemsControl">

                            <Setter
                                Property="Visibility"
                                Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsNoteBank}"
                                    Value="True">

                                    <Setter
                                        Property="Visibility"
                                        Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </ItemsControl.Style>


                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>

                            <UniformGrid
                                Columns="4"/>

                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>


                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button
                                Content="{Binding DisplayName}"
                                Style="{StaticResource PadButtonStyle}"
                                Command="{Binding DataContext.PlayPadCommand,
                                    RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding}"/>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>


                <!-- ================================================= -->
                <!-- BANCO DE ÁUDIOS / MÚSICAS -->
                <!-- ================================================= -->

                <ItemsControl
                    ItemsSource="{Binding FilteredPads}">

                    <ItemsControl.Style>

                        <Style
                            TargetType="ItemsControl">

                            <Setter
                                Property="Visibility"
                                Value="Visible"/>

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsNoteBank}"
                                    Value="True">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </ItemsControl.Style>


                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>

                            <StackPanel
                                Orientation="Vertical"/>

                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>


                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button
                                Content="{Binding DisplayName}"
                                Style="{StaticResource AudioButtonStyle}"
                                Command="{Binding DataContext.PlayPadCommand,
                                    RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding}"/>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </Grid>

        </ScrollViewer>


        <!-- ================================================= -->
        <!-- STOP -->
        <!-- ================================================= -->

        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Button
                Content="STOP"
                Command="{Binding StopCommand}"
                Style="{StaticResource StopButtonStyle}"
                MinWidth="100"
                Height="38"
                Margin="10"/>

        </StackPanel>

    </Grid>

</Window>
