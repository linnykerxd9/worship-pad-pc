<Window x:Class="WorshipPad.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Worship Pad"
        Width="900"
        Height="600"
        Background="#121212">

        <Window.Resources>
        <Style x:Key="PadButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="90"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsPlaying}"
                     Value="True">

                    <Setter Property="Background"
                    Value="#00AA55"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>
        <Style x:Key="BankButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsSelected}" Value="True">

                    <Setter Property="Background" Value="#2E7D32"/>
                    <Setter Property="FontWeight" Value="Bold"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>
    </Window.Resources>
    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <!-- BANCOS -->

        <ItemsControl Grid.Row="0"
                      ItemsSource="{Binding Banks}">

            <ItemsControl.ItemsPanel>

                <ItemsPanelTemplate>

                    <StackPanel Orientation="Horizontal"/>

                </ItemsPanelTemplate>

            </ItemsControl.ItemsPanel>


            <ItemsControl.ItemTemplate>

                <DataTemplate>

                    <Button
    Content="{Binding Name}"
    Style="{StaticResource BankButtonStyle}"
    Command="{Binding DataContext.SelectBankCommand,
              RelativeSource={RelativeSource AncestorType=Window}}"
    CommandParameter="{Binding}"/>

                </DataTemplate>

            </ItemsControl.ItemTemplate>


        </ItemsControl>



        <!-- BANCO ATUAL -->

        <TextBlock Grid.Row="1"
                   Text="{Binding CurrentBank}"
                   Foreground="White"
                   FontSize="24"
                   HorizontalAlignment="Center"
                   Margin="10"/>




        <!-- PADS -->

        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding Pads}">


            <ItemsControl.ItemsPanel>

                <ItemsPanelTemplate>

                    <UniformGrid Columns="4"/>

                </ItemsPanelTemplate>

            </ItemsControl.ItemsPanel>



            <ItemsControl.ItemTemplate>

                <DataTemplate>


                    <Button
    Content="{Binding DisplayName}"
    Style="{StaticResource PadButtonStyle}"
    Command="{Binding DataContext.PlayPadCommand,
              RelativeSource={RelativeSource AncestorType=Window}}"
    CommandParameter="{Binding}"/>

                </DataTemplate>


            </ItemsControl.ItemTemplate>

    
        </ItemsControl>
        <StackPanel
    Grid.Row="3"
    Orientation="Horizontal"
    HorizontalAlignment="Center"
    VerticalAlignment="Center">

            <ComboBox
    Width="250"
    ItemsSource="{Binding AudioDevices}"
    SelectedItem="{Binding SelectedAudioDevice}"
    Margin="10"/>
            
            <TextBlock
        Text="Volume"
        Foreground="White"
        FontSize="18"
        Margin="10"/>


            <Slider
    Width="250"
    Minimum="0"
    Maximum="1"
    Value="{Binding Volume, Mode=TwoWay}"
    Margin="10"
    IsMoveToPointEnabled="True"
    SmallChange="0.01"
    LargeChange="0.1"/>

            <TextBlock
    Text="{Binding Volume}"
    Foreground="White"
    FontSize="20"/>


            <Button
        Content="STOP"
        Command="{Binding StopCommand}"
        Width="100"
        Height="40"
        Margin="10"/>


        </StackPanel>
        <Button
    Content="⚙ Configurações"
    Width="150"
    Height="40"
    Margin="10"
    Click="OpenSettings_Click"/>
    </Grid>


</Window>