<Window
    x:Class="WorshipPad.Views.LogsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:WorshipPad.Converters"
    Title="Logs do sistema"
    Width="950"
    Height="650"
    Icon="../Assets/worshippad.ico"
    MinWidth="650"
    MinHeight="450"
    Background="#0D1014"
    Foreground="White"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- CONVERTER DOS NÍVEIS DE LOG -->
        <!-- ===================================================== -->

        <converters:LogLevelToBrushConverter
            x:Key="LogLevelToBrushConverter"/>


        <!-- ===================================================== -->
        <!-- FUNDO DA JANELA -->
        <!-- ===================================================== -->

        <LinearGradientBrush
            x:Key="WindowGradient"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#11151B"
                Offset="0"/>

            <GradientStop
                Color="#0C1116"
                Offset="0.55"/>

            <GradientStop
                Color="#080B0F"
                Offset="1"/>

        </LinearGradientBrush>


        <!-- ===================================================== -->
        <!-- FUNDO DA LISTA -->
        <!-- ===================================================== -->

        <LinearGradientBrush
            x:Key="LogsBackground"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#151A20"
                Offset="0"/>

            <GradientStop
                Color="#10151A"
                Offset="1"/>

        </LinearGradientBrush>


        <!-- ===================================================== -->
        <!-- BOTÃO -->
        <!-- ===================================================== -->

        <Style
            x:Key="LogButtonStyle"
            TargetType="Button">

            <Setter
                Property="Background"
                Value="#252C34"/>

            <Setter
                Property="Foreground"
                Value="White"/>

            <Setter
                Property="BorderBrush"
                Value="#3B444F"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="FontSize"
                Value="14"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

            <Setter
                Property="Padding"
                Value="15,8"/>

            <Setter
                Property="Height"
                Value="40"/>

            <Setter
                Property="Cursor"
                Value="Hand"/>

            <Setter
                Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextElement.FontWeight="{TemplateBinding FontWeight}"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <!-- HOVER -->

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#35404B"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#586574"/>

                            </Trigger>


                            <!-- PRESSIONADO -->

                            <Trigger
                                Property="IsPressed"
                                Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#1E252C"/>

                            </Trigger>


                            <!-- DESABILITADO -->

                            <Trigger
                                Property="IsEnabled"
                                Value="False">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- ITEM DA LISTA -->
        <!-- ===================================================== -->

        <Style
            x:Key="LogListItemStyle"
            TargetType="ListViewItem">

            <Setter
                Property="Background"
                Value="Transparent"/>

            <Setter
                Property="Foreground"
                Value="White"/>

            <Setter
                Property="Padding"
                Value="0"/>

            <Setter
                Property="Margin"
                Value="0"/>

            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch"/>

            <Setter
                Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="ListViewItem">

                        <Border
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Margin="4,3">

                            <ContentPresenter/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <!-- HOVER -->

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="#1D242B"/>

                            </Trigger>


                            <!-- SELECIONADO -->

                            <Trigger
                                Property="IsSelected"
                                Value="True">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="#202A31"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ===================================================== -->
    <!-- FUNDO -->
    <!-- ===================================================== -->

    <Grid
        Background="{StaticResource WindowGradient}"
        Margin="20">

        <Grid.RowDefinitions>

            <!-- Título -->
            <RowDefinition
                Height="Auto"/>

            <!-- Lista -->
            <RowDefinition
                Height="*"/>

            <!-- Botões -->
            <RowDefinition
                Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- CABEÇALHO -->
        <!-- ================================================= -->

        <Grid
            Grid.Row="0"
            Margin="5,0,5,18">

            <Grid.ColumnDefinitions>

                <ColumnDefinition
                    Width="*"/>

                <ColumnDefinition
                    Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel
                Grid.Column="0">

                <TextBlock
                    Text="Logs do sistema"
                    Foreground="White"
                    FontSize="30"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Registro de eventos e erros do WorshipPad"
                    Foreground="#8D98A5"
                    FontSize="13"
                    Margin="0,4,0,0"/>

            </StackPanel>

        </Grid>


        <!-- ================================================= -->
        <!-- LISTA DE LOGS -->
        <!-- ================================================= -->

        <Border
            Grid.Row="1"
            Background="{StaticResource LogsBackground}"
            BorderBrush="#252C35"
            BorderThickness="1"
            CornerRadius="14"
            Padding="8">

            <ListView
                ItemsSource="{Binding Entries}"
                Background="Transparent"
                BorderThickness="0"
                Foreground="White"
                ItemContainerStyle="{StaticResource LogListItemStyle}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="10,9"
                            BorderThickness="0,0,0,1"
                            BorderBrush="#252C35">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <!-- Hora -->
                                    <ColumnDefinition
                                        Width="85"/>

                                    <!-- Nível -->
                                    <ColumnDefinition
                                        Width="95"/>

                                    <!-- Mensagem -->
                                    <ColumnDefinition
                                        Width="*"/>

                                </Grid.ColumnDefinitions>


                                <!-- ============================= -->
                                <!-- HORA -->
                                <!-- ============================= -->

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding Time}"
                                    Foreground="#7F8994"
                                    FontSize="13"
                                    VerticalAlignment="Top"
                                    Margin="4,2,0,0"/>


                                <!-- ============================= -->
                                <!-- NÍVEL -->
                                <!-- ============================= -->

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding LevelText}"
                                    FontWeight="Bold"
                                    FontSize="13"
                                    Foreground="{Binding Level,
                                        Converter={StaticResource LogLevelToBrushConverter}}"
                                    VerticalAlignment="Top"
                                    Margin="4,2,8,0"/>


                                <!-- ============================= -->
                                <!-- MENSAGEM -->
                                <!-- ============================= -->

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Message}"
                                    TextWrapping="Wrap"
                                    Foreground="#E7EBEF"
                                    FontSize="14"
                                    LineHeight="20"
                                    VerticalAlignment="Top"
                                    Margin="4,0,8,0"/>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

        </Border>


        <!-- ================================================= -->
        <!-- BOTÕES -->
        <!-- ================================================= -->

        <StackPanel
    Grid.Row="2"
    Orientation="Horizontal"
    HorizontalAlignment="Right"
    Margin="0,15,0,0">

            <Button
        Content="↻ Atualizar"
        Width="110"
        Margin="5"
        Style="{StaticResource LogButtonStyle}"
        Command="{Binding RefreshCommand}"/>

            <Button
        Content="📂 Abrir arquivo"
        Width="130"
        Margin="5"
        Style="{StaticResource LogButtonStyle}"
        Command="{Binding OpenFileCommand}"/>

            <Button
        Content="Limpar"
        Width="100"
        Margin="5"
        Style="{StaticResource LogButtonStyle}"
        Command="{Binding ClearCommand}"/>

        </StackPanel>

    </Grid>

</Window>