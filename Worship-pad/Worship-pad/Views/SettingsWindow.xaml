<Window
    x:Class="WorshipPad.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Configurações"
    Width="520"
    Height="650"
    MinWidth="400"
    MinHeight="450"
    Background="#0D1014"
    Foreground="White"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- FUNDO DA JANELA -->
        <!-- ===================================================== -->

        <LinearGradientBrush
            x:Key="WindowGradient"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#11151B"
                Offset="0"/>

            <GradientStop
                Color="#0C1116"
                Offset="1"/>

        </LinearGradientBrush>


        <!-- ===================================================== -->
        <!-- FUNDO DO COMBOBOX -->
        <!-- ===================================================== -->

        <LinearGradientBrush
            x:Key="ComboBackground"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#3B424D"
                Offset="0"/>

            <GradientStop
                Color="#303640"
                Offset="0.5"/>

            <GradientStop
                Color="#272D36"
                Offset="1"/>

        </LinearGradientBrush>


        <!-- ===================================================== -->
        <!-- HOVER DO COMBOBOX -->
        <!-- ===================================================== -->

        <LinearGradientBrush
            x:Key="ComboHoverBackground"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#525B68"
                Offset="0"/>

            <GradientStop
                Color="#444D5A"
                Offset="0.5"/>

            <GradientStop
                Color="#353D49"
                Offset="1"/>

        </LinearGradientBrush>


        <!-- ===================================================== -->
        <!-- VERDE DA SELEÇÃO -->
        <!-- ===================================================== -->

        <LinearGradientBrush
            x:Key="NeonGreenGradient"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#009B6B"
                Offset="0"/>

            <GradientStop
                Color="#008F63"
                Offset="0.5"/>

            <GradientStop
                Color="#007A55"
                Offset="1"/>

        </LinearGradientBrush>


        <!-- ===================================================== -->
        <!-- BORDA DO COMBO -->
        <!-- ===================================================== -->

        <SolidColorBrush
            x:Key="ComboBorder"
            Color="#59616E"/>


        <!-- ===================================================== -->
        <!-- FUNDO DO DROPDOWN -->
        <!-- ===================================================== -->

        <SolidColorBrush
            x:Key="ComboDropBackground"
            Color="#1B2027"/>


        <!-- ===================================================== -->
        <!-- LABELS -->
        <!-- ===================================================== -->

        <Style
            x:Key="SettingsLabelStyle"
            TargetType="TextBlock">

            <Setter
                Property="Foreground"
                Value="#E8EDF2"/>

            <Setter
                Property="FontSize"
                Value="17"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

        </Style>


        <!-- ===================================================== -->
        <!-- SEÇÕES -->
        <!-- ===================================================== -->

        <Style
            x:Key="SettingsSectionStyle"
            TargetType="Border">

            <Setter
                Property="Background"
                Value="#151A20"/>

            <Setter
                Property="BorderBrush"
                Value="#252C35"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="CornerRadius"
                Value="14"/>

            <Setter
                Property="Padding"
                Value="18"/>

            <Setter
                Property="Margin"
                Value="0,0,0,18"/>

        </Style>


        <!-- ===================================================== -->
        <!-- TOGGLE BUTTON DO COMBOBOX -->
        <!-- ===================================================== -->

        <Style
            x:Key="ComboToggleButtonStyle"
            TargetType="ToggleButton">

            <Setter
                Property="Background"
                Value="{StaticResource ComboBackground}"/>

            <Setter
                Property="BorderBrush"
                Value="{StaticResource ComboBorder}"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="Padding"
                Value="12,0"/>

            <Setter
                Property="FocusVisualStyle"
                Value="{x:Null}"/>

            <Setter
                Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="ToggleButton">

                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            SnapsToDevicePixels="True">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="*"/>

                                    <ColumnDefinition
                                        Width="35"/>

                                </Grid.ColumnDefinitions>


                                <!-- TEXTO SELECIONADO -->

                                <ContentPresenter
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="4,0,0,0"
                                    RecognizesAccessKey="True"
                                    TextElement.Foreground="White"
                                    TextElement.FontWeight="SemiBold"/>


                                <!-- SETA -->

                                <Path
                                    x:Name="Arrow"
                                    Grid.Column="1"
                                    Width="9"
                                    Height="6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="White"
                                    Data="M 0 0 L 9 0 L 4.5 6 Z"/>

                            </Grid>

                        </Border>


                        <ControlTemplate.Triggers>

                            <!-- HOVER -->

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="Border"
                                    Property="Background"
                                    Value="{StaticResource ComboHoverBackground}"/>

                                <Setter
                                    TargetName="Border"
                                    Property="BorderBrush"
                                    Value="#707A89"/>

                            </Trigger>


                            <!-- ABERTO -->

                            <Trigger
                                Property="IsChecked"
                                Value="True">

                                <Setter
                                    TargetName="Border"
                                    Property="BorderBrush"
                                    Value="#008F63"/>

                            </Trigger>


                            <!-- DESABILITADO -->

                            <Trigger
                                Property="IsEnabled"
                                Value="False">

                                <Setter
                                    TargetName="Border"
                                    Property="Opacity"
                                    Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- COMBOBOX -->
        <!-- ===================================================== -->

        <Style
            x:Key="SettingsComboBoxStyle"
            TargetType="ComboBox">

            <Setter
                Property="Foreground"
                Value="White"/>

            <Setter
                Property="Background"
                Value="{StaticResource ComboBackground}"/>

            <Setter
                Property="BorderBrush"
                Value="{StaticResource ComboBorder}"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="FontSize"
                Value="14"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

            <Setter
                Property="Height"
                Value="44"/>

            <Setter
                Property="HorizontalContentAlignment"
                Value="Left"/>

            <Setter
                Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter
                Property="Padding"
                Value="12,0"/>

            <Setter
                Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="ComboBox">

                        <Grid>

                            <!-- ================================================= -->
                            <!-- BOTÃO DO COMBO -->
                            <!-- ================================================= -->

                            <ToggleButton
                                x:Name="ToggleButton"
                                Style="{StaticResource ComboToggleButtonStyle}"
                                IsChecked="{Binding IsDropDownOpen,
                                    RelativeSource={RelativeSource TemplatedParent},
                                    Mode=TwoWay}"
                                Focusable="False"
                                ClickMode="Press">

                                <ContentPresenter
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    RecognizesAccessKey="True"
                                    TextElement.Foreground="White"
                                    TextElement.FontWeight="SemiBold"/>

                            </ToggleButton>


                            <!-- ================================================= -->
                            <!-- DROPDOWN -->
                            <!-- ================================================= -->

                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=ToggleButton}"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                PopupAnimation="Fade"
                                StaysOpen="False">

                                <Border
                                    Margin="0,5,0,0"
                                    Background="{StaticResource ComboDropBackground}"
                                    BorderBrush="#4E5866"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    MinWidth="{Binding ActualWidth,
                                        ElementName=ToggleButton}">

                                    <ScrollViewer
                                        MaxHeight="260"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>


                        <ControlTemplate.Triggers>

                            <!-- SEM ITENS -->

                            <Trigger
                                Property="HasItems"
                                Value="False">

                                <Setter
                                    TargetName="PART_Popup"
                                    Property="MinHeight"
                                    Value="40"/>

                            </Trigger>


                            <!-- DESABILITADO -->

                            <Trigger
                                Property="IsEnabled"
                                Value="False">

                                <Setter
                                    Property="Opacity"
                                    Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- COMBOBOX ITEM -->
        <!-- ===================================================== -->

        <Style
            TargetType="ComboBoxItem">

            <Setter
                Property="Foreground"
                Value="White"/>

            <Setter
                Property="Background"
                Value="Transparent"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

            <Setter
                Property="Padding"
                Value="12,10"/>

            <Setter
                Property="HorizontalContentAlignment"
                Value="Left"/>

            <Setter
                Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="ComboBoxItem">

                        <Border
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Margin="4,2"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextElement.FontWeight="{TemplateBinding FontWeight}"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <!-- ================================================= -->
                            <!-- HOVER -->
                            <!-- ================================================= -->

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="#414A57"/>

                                <Setter
                                    Property="Foreground"
                                    Value="White"/>

                            </Trigger>


                            <!-- ================================================= -->
                            <!-- SELECIONADO -->
                            <!-- ================================================= -->

                            <Trigger
                                Property="IsSelected"
                                Value="True">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource NeonGreenGradient}"/>

                                <Setter
                                    Property="Foreground"
                                    Value="White"/>

                                <Setter
                                    Property="FontWeight"
                                    Value="Bold"/>

                            </Trigger>


                            <!-- ================================================= -->
                            <!-- DESABILITADO -->
                            <!-- ================================================= -->

                            <Trigger
                                Property="IsEnabled"
                                Value="False">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Opacity"
                                    Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- SLIDER -->
        <!-- ===================================================== -->

        <Style
            x:Key="SettingsSliderStyle"
            TargetType="Slider">

            <Setter
                Property="Height"
                Value="32"/>

            <Setter
                Property="VerticalAlignment"
                Value="Center"/>

        </Style>

    </Window.Resources>


    <!-- ===================================================== -->
    <!-- FUNDO -->
    <!-- ===================================================== -->

    <Grid
        Background="{StaticResource WindowGradient}">

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <Grid
                Margin="30">

                <Grid.RowDefinitions>

                    <!-- Título -->
                    <RowDefinition
                        Height="Auto"/>

                    <!-- Tipo -->
                    <RowDefinition
                        Height="Auto"/>

                    <!-- Windows -->
                    <RowDefinition
                        Height="Auto"/>

                    <!-- ASIO -->
                    <RowDefinition
                        Height="Auto"/>

                    <!-- Volume -->
                    <RowDefinition
                        Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- TÍTULO -->
                <!-- ================================================= -->

                <TextBlock
                    Grid.Row="0"
                    Text="Configurações"
                    Foreground="White"
                    FontSize="30"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,30"/>


                <!-- ================================================= -->
                <!-- TIPO DE SAÍDA -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="1"
                    Style="{StaticResource SettingsSectionStyle}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition
                                Height="Auto"/>

                            <RowDefinition
                                Height="Auto"/>

                        </Grid.RowDefinitions>


                        <TextBlock
                            Grid.Row="0"
                            Text="Tipo de saída"
                            Style="{StaticResource SettingsLabelStyle}"/>


                        <ComboBox
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            MinWidth="250"
                            ItemsSource="{Binding OutputTypes}"
                            SelectedItem="{Binding SelectedOutputType, Mode=TwoWay}"
                            Style="{StaticResource SettingsComboBoxStyle}"
                            Margin="0,10,0,0"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- WINDOWS -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="2"
                    Visibility="{Binding WindowsVisibility}"
                    Style="{StaticResource SettingsSectionStyle}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition
                                Height="Auto"/>

                            <RowDefinition
                                Height="Auto"/>

                        </Grid.RowDefinitions>


                        <TextBlock
                            Grid.Row="0"
                            Text="Dispositivo Windows"
                            Style="{StaticResource SettingsLabelStyle}"/>


                        <ComboBox
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            MinWidth="250"
                            ItemsSource="{Binding AudioDevices}"
                            SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}"
                            Style="{StaticResource SettingsComboBoxStyle}"
                            Margin="0,10,0,0"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- ASIO -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="3"
                    Visibility="{Binding AsioVisibility}"
                    Style="{StaticResource SettingsSectionStyle}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition
                                Height="Auto"/>

                            <RowDefinition
                                Height="Auto"/>

                            <RowDefinition
                                Height="Auto"/>

                            <RowDefinition
                                Height="Auto"/>

                        </Grid.RowDefinitions>


                        <TextBlock
                            Grid.Row="0"
                            Text="Driver ASIO"
                            Style="{StaticResource SettingsLabelStyle}"/>


                        <ComboBox
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            MinWidth="250"
                            ItemsSource="{Binding AsioDrivers}"
                            SelectedItem="{Binding SelectedAsioDriver, Mode=TwoWay}"
                            Style="{StaticResource SettingsComboBoxStyle}"
                            Margin="0,10,0,22"/>


                        <TextBlock
                            Grid.Row="2"
                            Text="Canal de saída"
                            Style="{StaticResource SettingsLabelStyle}"/>


                        <ComboBox
                            Grid.Row="3"
                            HorizontalAlignment="Stretch"
                            MinWidth="250"
                            ItemsSource="{Binding AsioOutputChannels}"
                            SelectedItem="{Binding SelectedAsioOutputChannel, Mode=TwoWay}"
                            Style="{StaticResource SettingsComboBoxStyle}"
                            Margin="0,10,0,0"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- VOLUME -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="4"
                    Style="{StaticResource SettingsSectionStyle}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition
                                Height="Auto"/>

                            <RowDefinition
                                Height="Auto"/>

                        </Grid.RowDefinitions>


                        <TextBlock
                            Grid.Row="0"
                            Text="Volume inicial"
                            Style="{StaticResource SettingsLabelStyle}"/>


                        <Slider
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            Minimum="0"
                            Maximum="1"
                            Value="{Binding Volume, Mode=TwoWay}"
                            Margin="0,12,0,0"
                            IsMoveToPointEnabled="True"
                            SmallChange="0.01"
                            LargeChange="0.1"
                            Style="{StaticResource SettingsSliderStyle}"/>

                    </Grid>

                </Border>

            </Grid>

        </ScrollViewer>

    </Grid>

</Window>