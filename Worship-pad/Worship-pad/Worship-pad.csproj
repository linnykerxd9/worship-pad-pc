<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>WorshipPad</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

	<PropertyGroup>
		<ApplicationIcon>Instalador\Icons\Worship.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Instalador\Icons\Worship.ico" />
	</ItemGroup>
	
  <ItemGroup>
    <Folder Include="Audio\Effects\" />
    <Folder Include="Audio\Outputs\" />
    <Folder Include="Instalador\Icons\" />
  </ItemGroup>
	
	<ItemGroup>
		<Content Include="Pads\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	
  <ItemGroup>
	  
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	  
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

</Project>
